# ====================================================================
# Git 國防級版本控制隔離規範 (.gitignore)
# 專案：my-resume-Astrotheme (Henry Lu / Paul Smith 履歷作品集網站)
# 標準：對齊 Happy-Halloween 資深架構師雙平台防禦縱深規範
# ====================================================================

# ==========================================
# 1. 靜態編譯產物與框架快取 (Astro / Vite / Dist)
# ==========================================
dist/
.astro/
.cache/
.parcel-cache/

# ==========================================
# 2. Node.js 相依套件與除錯日誌
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# 3. 敏感環境變數與安全金鑰 (絕對禁止進 Git)
# ==========================================
.env
.env.*
*.env
*.secret
*.pem
*.key
*.cert
*.pfx

# ==========================================
# 4. 作業系統暫存與本機 IDE 設定
# ==========================================
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp

# ==========================================
# 5. 本地壓縮包與備份檔案庫
# ==========================================
*.bundle
*.zip
*.tar.gz
*.7z
*.rar
*.bak
backup/

# ==========================================
# 6. AI 記憶庫、對話日誌與隱私安全絕對隔離 (完全禁止上傳)
# ==========================================
CONVERSATION_MEMORY.md
TOKEN_OPTIMIZATION_GLOBAL.md
SEO_REPORT.md
MAINTENANCE_REPORT.md
AUDIT_REPORT.md
brain/
brain/**/*
logs/
logs/**/*
*.log
*.jsonl
transcript*.jsonl
scratch/
scratch/**/*
.system_generated/
.gemini/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ==========================================
# 7. 本地維運批次檔與本地檢測腳本
# (保留雲端建置核心 scripts/enforce-node24.mjs)
# ==========================================
*.bat
scripts/run_all_audits.py
!scripts/enforce-node24.mjs
