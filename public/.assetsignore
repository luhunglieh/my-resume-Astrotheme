*.pdf
*.md
*.ts
*.tsx
*.astro
*.py
*.bat
*.sh
*.ps1
*.jsonc
*.jsonl
*.log
*.yml
*.yaml
.env*
.dev.vars*
.git*
.DS_Store
Thumbs.db
desktop.ini
CNAME
LICENSE
README*
netlify.toml
wrangler.jsonc
package.json
package-lock.json
tsconfig.json
